# ---- Server ----
PORT=4000
# Comma-separated allowed origins for CORS (client URL)
CORS_ORIGIN=http://localhost:5173

# ---- Firebase Admin ----
# Option A: path to a service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# Option B: inline service account (JSON string). If set, takes precedence.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_PROJECT_ID=your-firebase-project-id
# Firebase Storage bucket (used only if you store files in cloud; local share is default)
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# ---- File storage (Windows share / local folder) ----
# Root folder where uploaded Excel files are written.
# Structure created inside: {SHARE}/{category}/{year}/{month}/{file}
FILE_SHARE_ROOT=/mnt/excelshare
# Max upload size in bytes (default 50 MB)
MAX_UPLOAD_BYTES=52428800

# ---- Guacamole / RDP ----
# 128-bit key as 32 hex characters (16 bytes). MUST match guacamole.properties json-secret-key.
GUAC_JSON_SECRET_KEY=4c0b569e4c96df157eee1b65dd0e4d41
# Base URL of the Guacamole web app
GUAC_BASE_URL=https://guac.host/guacamole
# Windows machine that hosts the real desktop Excel (RDP host)
WINDOWS_RDP_HOST=192.168.1.50
WINDOWS_RDP_PORT=3389
WINDOWS_RDP_USER=exceluser
WINDOWS_RDP_PASS=changeme
# RemoteApp alias published on Windows for Excel
GUAC_REMOTE_APP=||excel

# Max concurrent Guacamole/Excel sessions
MAX_SESSIONS=3
# Token validity in milliseconds
TOKEN_TTL_MS=60000
